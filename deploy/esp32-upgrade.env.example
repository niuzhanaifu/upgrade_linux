ESP_UPGRADE_HOST=0.0.0.0
ESP_UPGRADE_PORT=8010
ESP_UPGRADE_BASE_DIR=/codebase/upgrade_linux/work

# Fill these after the deployment framework is running.
ESP_UPGRADE_REPO_URL=
ESP_UPGRADE_REPO_BRANCH=
ESP_UPGRADE_BUILD_COMMAND=
ESP_UPGRADE_BUILD_SCRIPT=/root/codebase/esp32/projects/fetch_build_lula_esp32.sh
ESP_UPGRADE_BUILD_SCRIPT_WORKDIR=/root/codebase/esp32/projects
ESP_UPGRADE_BUILD_INCREMENTAL_ARG=--incremental
ESP_UPGRADE_BUILD_FULL_ARG=--full
ESP_UPGRADE_BUILD_RECORDS_PATH=/codebase/upgrade_linux/work/build_records.json
ESP_UPGRADE_FIRMWARE_PATH=
ESP_UPGRADE_UPGRADE_COMMAND=

# Release OTA endpoint:
# POST /v1/firmware/ota/
# GET  /firmwares/xiaozhi.bin
ESP_OTA_PUBLIC_BASE_URL=http://14.103.183.47:8010
ESP_OTA_LATEST_VERSION=
ESP_OTA_FIRMWARE_DIR=/codebase/upgrade_linux/firmwares
ESP_OTA_FIRMWARE_FILE=xiaozhi.bin
ESP_OTA_FORCE=0
ESP_OTA_LOG_BODY=1
